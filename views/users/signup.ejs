<% layout("./layouts/bp.ejs") %>
<body>
    <div class="signup-container">
        <form method="POST" action="/user/signup" novalidate class="signup-form needs-validation offset-2 col-8">
            <h1>Signup</h1><br>
           <div class="mb-3">
            <label for="name" class="form-label " style="font-size: larger;">User Name</label><br>
            <input type="text" id="name" class="form-control"  name="username" placeholder="Enter your name" required>
            <div class="invalid-feedback">Name is required</div> 
           </div>
    
           <div class="mb-3">
            <label for="email" class="form-label" style="font-size: larger;">Gmail</label><br>
            <input type="email" id="email" name="email" class="form-control" placeholder="abc@gmail.com" required>
            <div class="invalid-feedback">Mail is required</div> 
           </div>
    
           <div class="mb-3">
            <label for="phoneNo" class="form-label" style="font-size: larger;">Phone No</label><br>
            <input type="text" id="phoneNo" name="phoneNo" class="form-control" placeholder="XXXXXXXXXX" required>
            <div class="invalid-feedback">PhoneNo is required</div> 
           </div>
    
           <div class="mb-3">
            <label for="password" class="form-label" style="font-size: larger;">Password</label><br>
            <input type="password" id="password" class="form-control" name="password" required>
            <div class="invalid-feedback">Password is required</div> 
           </div>
    
           <button>Signup</button>
        </form>
    </div>
   
</body>