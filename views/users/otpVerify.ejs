<%layout("./layouts/bp.ejs")%>
<body>
  
        <div class="login-container">
            <form method="POST" action="/user/signup/otpVerify" class="needs-validation offset-2" novalidate>
                <h2 >Otp Verification</h2><br>
                <div class=" col-8">
                    <label for="otp" class="form-label" style="font-size: larger;">Enter OTP</label>
                    <input type="text" class="form-control" id="otp" required name="otp" maxlength="4" minlength="4">
                    <div class="invalid-feedback">
                     Please enter valid 4-digit otp
                    </div>
                </div>
                <br>
                <div class="col-8">

                    <input type="hidden" class="form-control"  name="email" value="<%= email %>">
                   
                </div>
                <button >Confirm</button>

                <p><b>Note : </b> Also check spam section if you can't find it in inbox.</p>
            </form>
        </div>
    
</body>