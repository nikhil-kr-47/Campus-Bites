<%layout("./layouts/bp.ejs")%>
<body>
   
    <div class="login-container">
        <form action="/user/login" method="POST" novalidate  class="login-form offset-2 col-8 needs-validation">
            <h1>Login</h1><br>
            <div>
                <label for="username" class="form-label" style="font-size: larger;">Username</label>
                <input type="text" id="username" name="username" class="form-control" required>
                <div class="invalid-feedback">Write Username</div>
            </div>
           
            <br>
            <div>
                <label for="password" class="form-label" style="font-size: larger;">Password</label>
            <input type="password"  id="password" name="password" class="form-control" required>
            <div class="invalid-feedback">
               Password is required
            </div>
            </div>
            
           <br>
            <button id="login-button">Submit</button>
           <br><br>
            <div class="login-form-links">
               New user? <a href="/user/signup" style="color: blue;">Signup</a><br><br>
              <a href="/user/resetPassword" style="color: blue;">Forgot Password</a>
            </div>
        </form>
    </div>
   
  
</body>
