<%layout("./layouts/bp.ejs")%>
<body>
    <h2>Reset Password</h2><br>
    <div class="login-container">
        <form method="POST" action="/user/resetPassword" class="needs-validation" novalidate>
            <div class="offset-2 col-8">
                <label for="email" class="form-label" style="font-size: larger;">Gmail</label>
                <input type="email" class="form-control" id="email"required name="email">
                <div class="invalid-feedback">
                 Please enter email
                </div>
            </div>
            <br>
            <button class="offset-2">Submit</button>
        </form>
    </div>
   
</body>