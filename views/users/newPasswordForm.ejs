<%layout("./layouts/bp.ejs")%>
<body>
    <form action="/user/setNewPassword?token=<%= token %>" method="POST" class="needs-validation" novalidate>
        <div class="login-container offset-2">
            <div class="col-8 ">
                <label for="new-pass" class="form-label">New Password</label>
                <input type="password" class="form-control" id="new-pass"  name="new-password" required>
                <div class="invalid-feedback">
                 Please enter new password!
                </div>
              </div>
<br>
              <div class="col-8 ">
                <label for="confirm-new-pass" class="form-label">Confirm New Password</label>
                <input type="password" class="form-control" id="confirm-new-pass" name="confirmNewPassword" required>
                <div class="invalid-feedback">
                Password doesn't match!
                </div>
              </div><br>
             <button id="reset-password-btn" disabled >Submit</button>
        </div>
       
    </form>
</body>