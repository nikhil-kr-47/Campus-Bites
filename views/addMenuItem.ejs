<%layout("./layouts/bp.ejs")%>
<body>
   
       <div class="add-menu-form"></div>
        <form method="POST" action="/menu/add" class="needs-validation col-8 offset-2" novalidate>
            <h1>Add Item</h1><br>
            <div >
                <label for="name" class="form-label" style="font-size: larger;">Name</label>
                <input type="text" id="name" name="name" class="form-control" required>
                <div class="invalid-feedback">
                    Please enter name!
                </div>
            </div>
         <br>
            <div>
                <label for="price" class="form-label" style="font-size: larger;">Price</label>
                <input type="number" id="price" name="price" class="form-control" required>
                <div class="invalid-feedback">
                    Please enter price!
                </div>
            </div><br>
            <button>Add</button>
        </form>
    
</body>